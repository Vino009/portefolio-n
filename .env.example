# Copiez ces variables dans Vercel > Project > Settings > Environment Variables.
# Ne mettez jamais de vraie clé dans ce fichier ni dans le code.

# Clé API Resend (https://resend.com/api-keys) — secrète
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=

# Expéditeur vérifié chez Resend, ex. "Portfolio <contact@votredomaine.com>"
# Pour un premier test sans domaine : "Portfolio <onboarding@resend.dev>"
# (n'envoie alors qu'à l'adresse du compte Resend)
CONTACT_FROM_EMAIL=

# Facultatif : URL publique du site si vous utilisez un domaine personnalisé
# (sinon l'URL de production Vercel est utilisée automatiquement)
SITE_URL=
